<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:layoutDirection="rtl">

    <!-- ===================== شاشة القفل ===================== -->
    <LinearLayout
        android:id="@+id/lockScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/logo_circle" />

        <TextView
            android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/lock_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_sub"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <!-- رسالة الخطأ (تحجز مكانها دائماً حتى لا تقفز الواجهة) -->
        <TextView
            android:id="@+id/pinMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="7dp"
                android:background="@drawable/dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="7dp"
                android:background="@drawable/dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="7dp"
                android:background="@drawable/dot_empty" />

            <View
                android:id="@+id/dot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="7dp"
                android:background="@drawable/dot_empty" />
        </LinearLayout>

        <!-- يدفع لوحة الأرقام إلى الأسفل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- لوحة الأرقام (ltr: الرقم 1 على اليسار كما في لوحات الأرقام المعتادة) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/key1" style="@style/KeyButton" android:text="1" />
                <TextView android:id="@+id/key2" style="@style/KeyButton" android:text="2" />
                <TextView android:id="@+id/key3" style="@style/KeyButton" android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/key4" style="@style/KeyButton" android:text="4" />
                <TextView android:id="@+id/key5" style="@style/KeyButton" android:text="5" />
                <TextView android:id="@+id/key6" style="@style/KeyButton" android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/key7" style="@style/KeyButton" android:text="7" />
                <TextView android:id="@+id/key8" style="@style/KeyButton" android:text="8" />
                <TextView android:id="@+id/key9" style="@style/KeyButton" android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp" />

                <TextView android:id="@+id/key0" style="@style/KeyButton" android:text="0" />

                <ImageView
                    android:id="@+id/keyBack"
                    style="@style/KeyButton"
                    android:contentDescription="@string/cd_backspace"
                    android:padding="23dp"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/ink" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelSetup"
            style="@style/LinkText"
            android:layout_marginTop="4dp"
            android:text="@string/btn_cancel"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ===================== شاشة التحكم ===================== -->
    <LinearLayout
        android:id="@+id/controlScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/control_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:text="@string/control_sub"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <!-- بطاقة الواي فاي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_card_icon"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_name"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wifiState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/wifiSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_wifi_switch"
                android:layoutDirection="ltr"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track"
                app:showText="false" />
        </LinearLayout>

        <!-- بطاقة البلوتوث -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_card_icon"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_bluetooth"
                app:tint="@color/navy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_name"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/btSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_bt_switch"
                android:layoutDirection="ltr"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track"
                app:showText="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnChangePin"
            style="@style/LinkText"
            android:layout_gravity="center_horizontal"
            android:text="@string/btn_change_pin" />

        <TextView
            android:id="@+id/btnLock"
            style="@style/LinkText"
            android:layout_gravity="center_horizontal"
            android:text="@string/btn_lock" />

    </LinearLayout>

</FrameLayout>
